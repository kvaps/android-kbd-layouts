#
# Russian keyboard layout.
# This is a variant of the typical Russian PC keyboard layout that is presented
# on Mac keyboards.  In contrast with the standard layout, some of the symbols and
# punctuation characters have been rearranged.
# As an added convenience, English characters are accessible using ralt (Alt Gr).
#

type OVERLAY

# Caps Lock switches the keyboard layout
map key 58 LANGUAGE_SWITCH

# Command keys act as right Alt, so Command+Tab is the Alt+Tab app switcher
map key 125 ALT_RIGHT
map key 126 ALT_RIGHT

map key 86 PLUS

### ROW 1

key GRAVE {
    label:                              '>'
    base:                               '>'
    shift:                              '<'
}

key 1 {
    label:                              '1'
    base:                               '1'
    shift:                              '!'
}

key 2 {
    label:                              '2'
    base:                               '2'
    shift:                              '"'
}

key 3 {
    label:                              '3'
    base:                               '3'
    shift:                              '\u2116'
}

key 4 {
    label:                              '4'
    base:                               '4'
    shift:                              '%'
}

key 5 {
    label:                              '5'
    base:                               '5'
    shift:                              ':'
}

key 6 {
    label:                              '6'
    base:                               '6'
    shift:                              ','
}

key 7 {
    label:                              '7'
    base:                               '7'
    shift:                              '.'
}

key 8 {
    label:                              '8'
    base:                               '8'
    shift:                              ';'
}

key 9 {
    label:                              '9'
    base:                               '9'
    shift:                              '('
}

key 0 {
    label:                              '0'
    base:                               '0'
    shift:                              ')'
}

key MINUS {
    label:                              '-'
    base:                               '-'
    shift:                              '_'
}

key EQUALS {
    label:                              '='
    base:                               '='
    shift:                              '+'
}

### ROW 2

key Q {
    label:                              '\u0419'
    base:                               '\u0439'
    shift, capslock:                    '\u0419'
    shift+capslock:                     '\u0439'
}

key W {
    label:                              '\u0426'
    base:                               '\u0446'
    shift, capslock:                    '\u0426'
    shift+capslock:                     '\u0446'
}

key E {
    label:                              '\u0423'
    base:                               '\u0443'
    shift, capslock:                    '\u0423'
    shift+capslock:                     '\u0443'
}

key R {
    label:                              '\u041a'
    base:                               '\u043a'
    shift, capslock:                    '\u041a'
    shift+capslock:                     '\u043a'
}

key T {
    label:                              '\u0415'
    base:                               '\u0435'
    shift, capslock:                    '\u0415'
    shift+capslock:                     '\u0435'
}

key Y {
    label:                              '\u041d'
    base:                               '\u043d'
    shift, capslock:                    '\u041d'
    shift+capslock:                     '\u043d'
}

key U {
    label:                              '\u0413'
    base:                               '\u0433'
    shift, capslock:                    '\u0413'
    shift+capslock:                     '\u0433'
}

key I {
    label:                              '\u0428'
    base:                               '\u0448'
    shift, capslock:                    '\u0428'
    shift+capslock:                     '\u0448'
}

key O {
    label:                              '\u0429'
    base:                               '\u0449'
    shift, capslock:                    '\u0429'
    shift+capslock:                     '\u0449'
}

key P {
    label:                              '\u0417'
    base:                               '\u0437'
    shift, capslock:                    '\u0417'
    shift+capslock:                     '\u0437'
}

key LEFT_BRACKET {
    label:                              '\u0425'
    base:                               '\u0445'
    shift, capslock:                    '\u0425'
    shift+capslock:                     '\u0445'
}

key RIGHT_BRACKET {
    label:                              '\u042a'
    base:                               '\u044a'
    shift, capslock:                    '\u042a'
    shift+capslock:                     '\u044a'
}

### ROW 3

key A {
    label:                              '\u0424'
    base:                               '\u0444'
    shift, capslock:                    '\u0424'
    shift+capslock:                     '\u0444'
}

key S {
    label:                              '\u042b'
    base:                               '\u044b'
    shift, capslock:                    '\u042b'
    shift+capslock:                     '\u044b'
}

key D {
    label:                              '\u0412'
    base:                               '\u0432'
    shift, capslock:                    '\u0412'
    shift+capslock:                     '\u0432'
}

key F {
    label:                              '\u0410'
    base:                               '\u0430'
    shift, capslock:                    '\u0410'
    shift+capslock:                     '\u0430'
}

key G {
    label:                              '\u041f'
    base:                               '\u043f'
    shift, capslock:                    '\u041f'
    shift+capslock:                     '\u043f'
}

key H {
    label:                              '\u0420'
    base:                               '\u0440'
    shift, capslock:                    '\u0420'
    shift+capslock:                     '\u0440'
}

key J {
    label:                              '\u041e'
    base:                               '\u043e'
    shift, capslock:                    '\u041e'
    shift+capslock:                     '\u043e'
}

key K {
    label:                              '\u041b'
    base:                               '\u043b'
    shift, capslock:                    '\u041b'
    shift+capslock:                     '\u043b'
}

key L {
    label:                              '\u0414'
    base:                               '\u0434'
    shift, capslock:                    '\u0414'
    shift+capslock:                     '\u0434'
}

key SEMICOLON {
    label:                              '\u0416'
    base:                               '\u0436'
    shift, capslock:                    '\u0416'
    shift+capslock:                     '\u0436'
}

key APOSTROPHE {
    label:                              '\u042d'
    base:                               '\u044d'
    shift, capslock:                    '\u042d'
    shift+capslock:                     '\u044d'
}

key BACKSLASH {
    label:                              '\u0401'
    base:                               '\u0451'
    shift, capslock:                    '\u0401'
    shift+capslock:                     '\u0451'
}

### ROW 4

key PLUS {
    label:                              '['
    base:                               '['
    shift:                              ']'
}

key Z {
    label:                              '\u042f'
    base:                               '\u044f'
    shift, capslock:                    '\u042f'
    shift+capslock:                     '\u044f'
}

key X {
    label:                              '\u0427'
    base:                               '\u0447'
    shift, capslock:                    '\u0427'
    shift+capslock:                     '\u0447'
    ralt:                               replace CUT
}

key C {
    label:                              '\u0421'
    base:                               '\u0441'
    shift, capslock:                    '\u0421'
    shift+capslock:                     '\u0441'
    ralt:                               replace COPY
}

key V {
    label:                              '\u041c'
    base:                               '\u043c'
    shift, capslock:                    '\u041c'
    shift+capslock:                     '\u043c'
    ralt:                               replace PASTE
}

key B {
    label:                              '\u0418'
    base:                               '\u0438'
    shift, capslock:                    '\u0418'
    shift+capslock:                     '\u0438'
}

key N {
    label:                              '\u0422'
    base:                               '\u0442'
    shift, capslock:                    '\u0422'
    shift+capslock:                     '\u0442'
}

key M {
    label:                              '\u042c'
    base:                               '\u044c'
    shift, capslock:                    '\u042c'
    shift+capslock:                     '\u044c'
}

key COMMA {
    label:                              '\u0411'
    base:                               '\u0431'
    shift, capslock:                    '\u0411'
    shift+capslock:                     '\u0431'
}

key PERIOD {
    label:                              '\u042e'
    base:                               '\u044e'
    shift, capslock:                    '\u042e'
    shift+capslock:                     '\u044e'
}

key SLASH {
    label:                              '/'
    base:                               '/'
    shift:                              '?'
}

### NUMPAD

key NUMPAD_DOT {
    label:                              ','
    base:                               fallback FORWARD_DEL
    numlock:                            ','
}

key NUMPAD_COMMA {
    label:                              ' '
    base:                               '\u202f'
}
